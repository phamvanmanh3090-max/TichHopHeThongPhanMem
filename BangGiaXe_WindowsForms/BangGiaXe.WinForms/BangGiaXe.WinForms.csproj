    <Content Include="T.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="H.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="B.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
